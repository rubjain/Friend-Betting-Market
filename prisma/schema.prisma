generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  username            String               @unique
  email               String               @unique
  role                UserRole             @default(USER)
  riskStatus          String               @default("clear")
  riskScore           Int                  @default(0)
  frozen              Boolean              @default(false)
  dailyDepositLimit   Decimal?             @db.Decimal(14, 2)
  selfExcludedUntil   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordHash        String?
  auditEntries        AuditTrail[]
  authTokens          AuthToken[]
  apiKeys             ApiKey[]
  strategies          Strategy[]
  strategyMarketplaceProfiles StrategyMarketplaceProfile[]
  strategySubscriptions StrategySubscription[]
  strategyTradeSignals StrategyTradeSignal[]
  copyTrades          CopyTrade[]
  strategyExecutions  StrategyExecution[]
  balanceAccounts     BalanceAccount[]
  bets                Bet[]
  boostsGiven         FriendBoost[]        @relation("BoostActor")
  friendshipsTo       Friendship[]         @relation("FriendshipAddressee")
  friendshipsFrom     Friendship[]         @relation("FriendshipRequester")
  ledgerEntries       LedgerEntry[]
  submitted           Market[]             @relation("SubmittedMarkets")
  disputes            MarketDispute[]
  orders              Order[]
  paymentTransactions PaymentTransaction[]
  billingSubscriptions BillingSubscription[]
  marketplaceInvoices MarketplaceInvoice[]
  marketplaceEntitlements MarketplaceEntitlement[]
  creatorPayouts      CreatorPayout[]
  creatorPayoutItems  CreatorPayoutItem[]
  listingModerationEvents ListingModerationEvent[] @relation("ListingModerationActor")
  payoutLedgerEvents  CreatorPayoutLedgerEvent[] @relation("PayoutLedgerActor")
  rateLimitBuckets    RateLimitBucket[]
  riskReviews         RiskReview[]
  sessions            UserSession[]
  verificationChecks  VerificationCheck[]
  comments            MarketComment[]
  ownedGroups         Group[]              @relation("OwnedGroups")
  groupMemberships    GroupMember[]
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  name       String   @default("API key")
  scopes     String[]
  keyHash    String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([revokedAt])
}

enum StrategyMode {
  PAPER
  REAL
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum StrategyType {
  RULES
  ML
}

model Strategy {
  id             String         @id @default(cuid())
  userId         String
  name           String
  mode           StrategyMode   @default(PAPER)
  status         StrategyStatus @default(DRAFT)
  type           StrategyType   @default(RULES)
  config         Json
  promotedFromId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotedFrom Strategy?   @relation("StrategyPromotion", fields: [promotedFromId], references: [id])
  promotedTo   Strategy[]  @relation("StrategyPromotion")
  executions   StrategyExecution[]
  marketplaceProfile StrategyMarketplaceProfile?
  tradeSignals StrategyTradeSignal[]

  @@index([userId, createdAt])
  @@index([mode, status])
}

model StrategyExecution {
  id         String   @id @default(cuid())
  strategyId String
  userId     String
  marketId   String?
  side       String?
  stake      Decimal? @db.Decimal(14, 2)
  isPaper    Boolean  @default(true)
  status     String   @default("CREATED")
  message    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([strategyId, createdAt])
  @@index([userId, createdAt])
}

enum AccountMode {
  PAPER
  REAL
}

enum StrategyProfileStatus {
  DRAFT
  UNDER_REVIEW
  REJECTED
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum StrategySubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum CopyTradeStatus {
  COPIED
  SKIPPED
  FAILED
}

model StrategyMarketplaceProfile {
  id               String                @id @default(cuid())
  strategyId       String                @unique
  creatorId        String
  slug             String                @unique
  name             String
  description      String
  marketsSupported String[]
  riskLevel        String
  priceCents       Int                   @default(0)
  status           StrategyProfileStatus @default(DRAFT)
  roiPct           Decimal               @default(0) @db.Decimal(8, 2)
  winRatePct       Decimal               @default(0) @db.Decimal(8, 2)
  maxDrawdownPct   Decimal               @default(0) @db.Decimal(8, 2)
  subscriberCount  Int                   @default(0)
  copiedVolume     Decimal               @default(0) @db.Decimal(14, 2)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  strategy      Strategy               @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  creator       User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions StrategySubscription[]
  tradeSignals  StrategyTradeSignal[]
  billingPlans  MarketplaceBillingPlan[]
  billingSubscriptions BillingSubscription[]
  invoices      MarketplaceInvoice[]
  entitlements  MarketplaceEntitlement[]
  moderationEvents ListingModerationEvent[]
  payoutLedgerEvents CreatorPayoutLedgerEvent[]
  payoutItems   CreatorPayoutItem[]

  @@index([creatorId, status])
  @@index([status, updatedAt])
}

enum BillingSubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  FAILED
  REFUNDED
}

enum EntitlementStatus {
  ACTIVE
  GRACE
  REVOKED
  EXPIRED
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  TAKEDOWN
  RESTORED
  NOTE
}

enum PayoutStatus {
  PENDING
  READY
  PAID
  HELD
  CANCELED
}

model MarketplaceBillingPlan {
  id              String   @id @default(cuid())
  profileId        String
  name            String
  interval        BillingInterval @default(MONTH)
  amountCents     Int
  active          Boolean  @default(true)
  providerProductId String?
  providerPriceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  billingSubscriptions BillingSubscription[]

  @@index([profileId, active])
}

model BillingSubscription {
  id                String                    @id @default(cuid())
  userId            String
  profileId         String
  planId            String
  status            BillingSubscriptionStatus @default(INCOMPLETE)
  provider          String                    @default("stripe")
  providerCustomerId String?
  providerSubscriptionId String?              @unique
  providerCheckoutSessionId String?
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  canceledAt        DateTime?
  endedAt           DateTime?
  latestInvoiceId   String?
  metadata          Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plan MarketplaceBillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  invoices MarketplaceInvoice[]
  entitlementEvents MarketplaceEntitlement[]

  @@unique([userId, profileId])
  @@index([profileId, status])
}

model MarketplaceInvoice {
  id                    String        @id @default(cuid())
  userId                String
  profileId             String
  billingSubscriptionId String
  provider              String        @default("stripe")
  providerInvoiceId     String?       @unique
  status                InvoiceStatus @default(DRAFT)
  amountDueCents        Int           @default(0)
  amountPaidCents       Int           @default(0)
  currency              String        @default("usd")
  dueAt                 DateTime?
  paidAt                DateTime?
  failureCode           String?
  failureMessage        String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  billingSubscription BillingSubscription @relation(fields: [billingSubscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([billingSubscriptionId, createdAt])
}

model MarketplaceEntitlement {
  id                    String            @id @default(cuid())
  userId                String
  profileId             String
  billingSubscriptionId String?
  status                EntitlementStatus @default(ACTIVE)
  source                String            @default("billing")
  startsAt              DateTime          @default(now())
  endsAt                DateTime?
  graceEndsAt           DateTime?
  revokedAt             DateTime?
  reason                String?
  metadata              Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  billingSubscription BillingSubscription? @relation(fields: [billingSubscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, profileId, status])
  @@index([billingSubscriptionId, createdAt])
}

model ListingModerationEvent {
  id        String           @id @default(cuid())
  profileId String
  actorId   String?
  action    ModerationAction
  reason    String?
  metadata  Json?
  createdAt DateTime         @default(now())

  profile StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actor User? @relation("ListingModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
}

model CreatorPayout {
  id          String       @id @default(cuid())
  creatorId   String
  periodStart DateTime
  periodEnd   DateTime
  currency    String       @default("usd")
  grossCents  Int          @default(0)
  feeCents    Int          @default(0)
  netCents    Int          @default(0)
  status      PayoutStatus @default(PENDING)
  providerRef String?
  paidAt      DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  items CreatorPayoutItem[]

  @@index([creatorId, status, periodEnd])
}

model CreatorPayoutItem {
  id          String   @id @default(cuid())
  payoutId    String
  creatorId   String
  profileId   String
  invoiceId   String?
  grossCents  Int      @default(0)
  feeCents    Int      @default(0)
  netCents    Int      @default(0)
  createdAt   DateTime @default(now())

  payout CreatorPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  profile StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  invoice MarketplaceInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([payoutId, profileId])
  @@index([invoiceId])
}

model CreatorPayoutLedgerEvent {
  id        String   @id @default(cuid())
  profileId String
  actorId   String?
  type      String
  amountCents Int
  currency  String   @default("usd")
  metadata  Json?
  createdAt DateTime @default(now())

  profile StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actor User? @relation("PayoutLedgerActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
}

model StrategySubscription {
  id               String                     @id @default(cuid())
  profileId        String
  userId           String
  accountMode      AccountMode                @default(PAPER)
  status           StrategySubscriptionStatus @default(ACTIVE)
  allocationPct    Decimal                    @db.Decimal(5, 2)
  maxTradeSize     Decimal?                   @db.Decimal(14, 2)
  maxDailyLoss     Decimal?                   @db.Decimal(14, 2)
  maxOpenPositions Int?
  allowedMarketIds String[]
  autoCopyEnabled  Boolean                    @default(true)
  startedAt        DateTime                   @default(now())
  canceledAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  profile    StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  copyTrades CopyTrade[]

  @@unique([profileId, userId, accountMode])
  @@index([userId, status])
  @@index([profileId, status])
}

model StrategyTradeSignal {
  id                String          @id @default(cuid())
  strategyId        String
  profileId         String
  creatorId         String
  sourceBetId       String?
  sourceExecutionId String?
  accountMode       AccountMode     @default(PAPER)
  marketId          String
  side              BetSide
  sourceStake       Decimal         @db.Decimal(14, 2)
  idempotencyKey    String          @unique
  status            String          @default("CREATED")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  strategy   Strategy                   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  profile    StrategyMarketplaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  creator    User                       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  copyTrades CopyTrade[]

  @@index([strategyId, createdAt])
  @@index([profileId, createdAt])
}

model CopyTrade {
  id             String          @id @default(cuid())
  signalId       String
  subscriptionId String
  subscriberId   String
  accountMode    AccountMode     @default(PAPER)
  status         CopyTradeStatus
  skipReason     String?
  stake          Decimal         @default(0) @db.Decimal(14, 2)
  copiedBetId    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  signal       StrategyTradeSignal  @relation(fields: [signalId], references: [id], onDelete: Cascade)
  subscription StrategySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriber   User                 @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([signalId, subscriptionId])
  @@index([subscriberId, createdAt])
  @@index([subscriptionId, createdAt])
}

model UserSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Market {
  id                 String               @id @default(cuid())
  title              String
  description        String
  category           String
  status             MarketStatus         @default(PENDING)
  closeAt            DateTime?
  settlementAt       DateTime?
  yesPrice           Decimal              @default(0.5) @db.Decimal(8, 4)
  noPrice            Decimal              @default(0.5) @db.Decimal(8, 4)
  volume             Decimal              @default(0) @db.Decimal(14, 2)
  eligibleForBonus   Boolean              @default(false)
  bonusUseLimitPct   Decimal?             @db.Decimal(5, 2)
  bonusPayoutCap     Decimal?             @db.Decimal(14, 2)
  resolutionTemplate String
  submittedById      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  closeTime          DateTime?
  createdBy          MarketCreatedBy      @default(USER)
  externalSourceId   String?
  externalSourceName String?
  metadata           Json?
  normalizedQuestion String?
  outcomeType        MarketOutcomeType    @default(BINARY)
  question           String               @default("")
  resolutionRules    String               @default("")
  resolutionSource   String?
  resolutionTime     DateTime?
  auditEntries       AuditTrail[]
  bets               Bet[]
  boosts             FriendBoost[]
  ledgerEntries      LedgerEntry[]
  liquidityPool      LiquidityPool?
  submittedBy        User?                @relation("SubmittedMarkets", fields: [submittedById], references: [id])
  disputes           MarketDispute[]
  resolution         MarketResolution?
  priceSnapshots     OddsSnapshot[]
  orders             Order[]
  evidenceLinks      ResolutionEvidence[]
  riskReviews        RiskReview[]
  comments           MarketComment[]

  @@unique([externalSourceName, externalSourceId])
  @@index([status, createdAt])
  @@index([normalizedQuestion])
}

model Bet {
  id                 String          @id @default(cuid())
  userId             String
  marketId           String
  side               BetSide
  status             BetStatus       @default(OPEN)
  stake              Decimal         @db.Decimal(14, 2)
  withdrawableStake  Decimal         @db.Decimal(14, 2)
  bonusStake         Decimal         @db.Decimal(14, 2)
  expectedMultiplier Decimal         @db.Decimal(8, 4)
  placedAt           DateTime        @default(now())
  settledAt          DateTime?
  isPaper            Boolean         @default(false)
  tradingMode        AccountMode     @default(REAL)
  grossAmount        Decimal         @default(0) @db.Decimal(14, 2)
  feeAmount          Decimal         @default(0) @db.Decimal(14, 2)
  netAmount          Decimal         @default(0) @db.Decimal(14, 2)
  isPaperTrade       Boolean         @default(false)
  feeDestination     String          @default("none")
  realizedPnL        Decimal         @default(0) @db.Decimal(14, 2)
  unrealizedPnL      Decimal         @default(0) @db.Decimal(14, 2)
  copiedFromProfileId String?
  copyTradeId        String?
  market             Market          @relation(fields: [marketId], references: [id])
  user               User            @relation(fields: [userId], references: [id])
  ledgerEntries      LedgerEntry[]
  disputes           MarketDispute[]

  @@index([copiedFromProfileId, placedAt])
  @@index([copyTradeId])
}

model OddsSnapshot {
  id        String   @id @default(cuid())
  marketId  String
  yesPrice  Decimal  @db.Decimal(8, 4)
  noPrice   Decimal  @db.Decimal(8, 4)
  volume    Decimal  @default(0) @db.Decimal(14, 2)
  source    String   @default("internal")
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id])

  @@index([marketId, createdAt])
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  marketId   String
  side       OrderSide
  status     OrderStatus @default(OPEN)
  quantity   Decimal     @db.Decimal(14, 4)
  limitPrice Decimal     @db.Decimal(8, 4)
  filledQty  Decimal     @default(0) @db.Decimal(14, 4)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  expiresAt  DateTime?
  isPaper    Boolean     @default(false)
  tradingMode AccountMode @default(REAL)
  grossAmount Decimal     @default(0) @db.Decimal(14, 2)
  feeAmount   Decimal     @default(0) @db.Decimal(14, 2)
  netAmount   Decimal     @default(0) @db.Decimal(14, 2)
  isPaperTrade Boolean    @default(false)
  feeDestination String   @default("none")
  market     Market      @relation(fields: [marketId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@index([marketId, status, createdAt])
  @@index([userId, createdAt])
}

model LiquidityPool {
  id         String   @id @default(cuid())
  marketId   String   @unique
  yesReserve Decimal  @default(0) @db.Decimal(18, 6)
  noReserve  Decimal  @default(0) @db.Decimal(18, 6)
  invariant  Decimal? @db.Decimal(18, 6)
  liquidityParameter Decimal @default(100) @db.Decimal(18, 6)
  feeBps     Int      @default(0)
  updatedAt  DateTime @updatedAt
  market     Market   @relation(fields: [marketId], references: [id])
}

model BalanceAccount {
  id        String          @id @default(cuid())
  userId    String
  currency  BalanceCurrency
  accountMode AccountMode   @default(REAL)
  balance   Decimal         @default(0) @db.Decimal(14, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])

  @@unique([userId, currency])
}

model LedgerEntry {
  id              String                @id @default(cuid())
  userId          String
  marketId        String?
  betId           String?
  transactionType LedgerTransactionType
  amount          Decimal               @db.Decimal(14, 2)
  currency        BalanceCurrency
  source          LedgerSource
  metadata        Json?
  createdAt       DateTime              @default(now())
  bet             Bet?                  @relation(fields: [betId], references: [id])
  market          Market?               @relation(fields: [marketId], references: [id])
  user            User                  @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([marketId, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id])

  @@unique([requesterId, addresseeId])
}

model FriendBoost {
  id        String   @id @default(cuid())
  marketId  String
  actorId   String
  createdAt DateTime @default(now())
  actor     User     @relation("BoostActor", fields: [actorId], references: [id])
  market    Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, actorId])
}

model AdminConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model RiskReview {
  id        String           @id @default(cuid())
  userId    String
  marketId  String?
  status    RiskReviewStatus @default(OPEN)
  score     Int
  signals   Json
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  market    Market?          @relation(fields: [marketId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
}

model MarketResolution {
  id         String               @id @default(cuid())
  marketId   String               @unique
  result     BetSide?
  status     ResolutionStatus     @default(DRAFT)
  resolverId String?
  notes      String?
  resolvedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  market     Market               @relation(fields: [marketId], references: [id])
  evidence   ResolutionEvidence[]
}

model MarketDispute {
  id        String        @id @default(cuid())
  userId    String
  marketId  String
  betId     String?
  status    DisputeStatus @default(OPEN)
  reason    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bet       Bet?          @relation(fields: [betId], references: [id])
  market    Market        @relation(fields: [marketId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@index([marketId, status, createdAt])
  @@index([userId, createdAt])
}

model ResolutionEvidence {
  id           String            @id @default(cuid())
  marketId     String
  resolutionId String?
  label        String
  url          String
  sourceType   String
  capturedAt   DateTime?
  createdAt    DateTime          @default(now())
  market       Market            @relation(fields: [marketId], references: [id])
  resolution   MarketResolution? @relation(fields: [resolutionId], references: [id])
}

model AuditTrail {
  id        String   @id @default(cuid())
  actorId   String?
  marketId  String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  market    Market?  @relation(fields: [marketId], references: [id])

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model VerificationCheck {
  id          String             @id @default(cuid())
  userId      String
  type        VerificationType
  status      VerificationStatus @default(PENDING)
  provider    String?
  referenceId String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@index([type, status])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  metadata  Json?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([expiresAt])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String?
  scope     String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([scope, resetAt])
  @@index([userId, scope])
}

model PaymentTransaction {
  id           String                   @id @default(cuid())
  userId       String
  type         PaymentTransactionType
  status       PaymentTransactionStatus @default(PENDING_REVIEW)
  amount       Decimal                  @db.Decimal(14, 2)
  currency     BalanceCurrency          @default(WITHDRAWABLE)
  provider     String                   @default("demo-ledger")
  providerRef  String?
  method       String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  metadata     Json?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, status, createdAt])
  @@index([provider, providerRef])
}

model MarketComment {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  content   String
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([marketId, createdAt])
  @@index([userId, createdAt])
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  inviteCode  String        @unique @default(cuid())
  createdAt   DateTime      @default(now())
  owner       User          @relation("OwnedGroups", fields: [ownerId], references: [id])
  members     GroupMember[]

  @@index([ownerId])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
}

